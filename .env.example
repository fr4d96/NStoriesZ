# WHV Compass NZ — environment variables
# Copy to .env.local (untracked) and point it at a dedicated Supabase
# DEVELOPMENT project — never production. See docs/architecture.md for the
# full local-vs-hosted-development Supabase workflow.

# --- Public (safe to expose to the browser) ---
# The publishable key (sb_publishable_...) replaces the legacy anon key.
# It's safe to expose: web pages, mobile/desktop apps, CI, source code.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_dev_project_key

# Base URL of the running app, used for absolute links in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only ---
# Service-role key — required for the image-processing/promotion pipeline
# (lib/story/image-pipeline.ts) — never exposed to browser-accessible code
# (Engineering Rule 1). Used ONLY by that one module (enforced by the
# `no-restricted-imports` ESLint rule in eslint.config.mjs).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_dev_project_service_role_key

# --- Maintenance script only (scripts/cleanup-abandoned-media-uploads.mjs) ---
# Deliberately separate from the vars above, loaded only via an explicit
# --env-file=.env.maintenance.local (gitignored) — never falls back to this
# file. See the script header comment for the exact fail-closed guard.
# SUPABASE_MAINTENANCE_URL=https://your-dev-project-ref.supabase.co
# SUPABASE_MAINTENANCE_PROJECT_REF=your-dev-project-ref
# SUPABASE_MAINTENANCE_SERVICE_ROLE_KEY=sb_secret_your_dev_project_service_role_key
# SUPABASE_MAINTENANCE_CONFIRM=i-confirm-cleanup-your-dev-project-ref
