# WHV Compass NZ — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Public (exposed to the browser — safe only because Supabase RLS enforces access) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only (never reference these in Client Components or anything bundled to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the deployed app, used for absolute links in sitemap/metadata/emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: only add if/when a moderation notification or transactional email provider is chosen.
# EMAIL_PROVIDER_API_KEY=
