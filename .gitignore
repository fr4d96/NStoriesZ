# dependencies
node_modules/
/.pnp
.pnp.*

# Next.js build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# environment (keep .env.example tracked)
.env*
!.env.example

# Supabase local
supabase/.temp/

# editor/OS
.DS_Store
*.pem

# Claude Code local session settings (not project config)
.claude/settings.local.json
# Agent-authored local skills -- machine-specific (absolute paths, this
# machine's Docker/Supabase situation), so not shared project config.
.claude/skills/dev-server/

# Nimbalyst editor local artifacts (not source, not project config)
# .nimbalyst/ holds per-session transcript screenshots; nimbalyst-local/
# holds working plan documents. Both are scratch output of a session, and
# neither is something a checkout needs.
.nimbalyst/
nimbalyst-local/

# test artifacts
coverage/
playwright-report/
test-results/

# vercel
.vercel

# throwaway local exploration output (not source, not test fixtures)
/scratch/

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
