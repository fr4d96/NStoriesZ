{
  "name": "kakinotes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:full": "npm run verify && playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migration:new": "supabase migration new",
    "supabase:types": "supabase gen types typescript --local --schema public > types/database.ts.tmp && mv types/database.ts.tmp types/database.ts",
    "supabase:types:linked": "supabase gen types typescript --linked --schema public > types/database.ts.tmp && mv types/database.ts.tmp types/database.ts",
    "test:rls": "node --env-file=.env.test.local node_modules/.bin/vitest run --config vitest.rls.config.ts",
    "test:rls:cleanup": "node --env-file=.env.test.local scripts/run-rls-cleanup.mjs",
    "media:cleanup:pending": "node --env-file=.env.maintenance.local scripts/cleanup-abandoned-media-uploads.mjs",
    "e2e:cleanup:editorial-fixtures": "node --env-file=.env.maintenance.local scripts/cleanup-editorial-e2e-fixtures.mjs"
  },
  "dependencies": {
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/floating": "^53.0.0",
    "@platejs/link": "^53.3.1",
    "@platejs/list": "^53.1.3",
    "@platejs/table": "^53.0.9",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.30.0",
    "next": "16.2.12",
    "node-html-parser": "^9.0.1",
    "platejs": "^53.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "use-sync-external-store": "^1.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
